{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subtandem.local/schemas/credential-store.json",
  "title": "SubTandem Plugin-Private Credential Store",
  "description": "Runtime-only plaintext document stored outside the package with POSIX mode 0600; never returned to Sidebar or diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "credentials"],
  "properties": {
    "formatVersion": { "const": 1 },
    "credentials": {
      "type": "object",
      "propertyNames": { "format": "uuid" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiKey"],
        "properties": {
          "apiKey": { "type": "string", "minLength": 1, "maxLength": 8192 }
        }
      }
    }
  }
}
